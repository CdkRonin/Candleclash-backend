MARKET_CONTRACT_ADDRESS=0x...
GAME_WALLET_PRIVATE_KEY=0x...  # ⚠ NUNCA subir al repositorio

# ─── CORS ────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=["https://candleclash.vercel.app","http://localhost:3000"]
